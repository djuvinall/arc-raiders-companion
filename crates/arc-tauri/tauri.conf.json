{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARC Raiders Companion",
  "version": "0.6.1",
  "identifier": "dev.arc-companion.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../ui"
    }
  },
  "app": {
    "windows": [
      {
        "title": "ARC Raiders Companion",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#0b0b0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: arcicon: http://arcicon.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzQkM0OEJDOUQwMUUzQkIKUldTNzR3R2R2RWk4RTZTeVUyeXFLOVlqb2I1ZWJKR0RMSUdHZWpzME0xaENsMUh1L05zVEdKMGQK",
      "endpoints": [
        "https://github.com/djuvinall/arc-raiders-companion/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
