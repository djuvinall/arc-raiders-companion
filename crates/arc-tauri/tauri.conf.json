{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARC Raiders Companion",
  "version": "0.1.0",
  "identifier": "dev.arc-companion.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" }
  },
  "app": {
    "windows": [
      {
        "title": "ARC Raiders Companion",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#0b0b0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: arcicon: http://arcicon.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
